+++ b/files/usr/bin/wwan_watchdog.sh
@@ -0,0 +1,98 @@
+#!/bin/sh
+
+# 目标检测地址（阿里公共DNS）
+TARGET="223.5.5.5"
+
+# 检测配置
+PING_COUNT=5      # 每次检测发送的包数量
+LOSS_LIMIT=50     # 丢包率阈值，超过此值判定为失败
+CHECK_INTERVAL=60 # 检测间隔（秒）
+FAIL_LIMIT=2      # 连续失败多少次后触发重启
+
+# 文件路径
+LOG_FILE="/var/log/wwan_watchdog.log"
+MAX_LOG_SIZE=50   # 日志最大占用空间 (KB)
+FAIL_FILE="/tmp/wwan_fail_count"
+
+# 驱动模块重载列表（Bug 4: 必须严格按依赖倒序卸载，正序加载）
+MODULES_REMOVE="mt7615e mt7615_common mt76x2_common mt76x02_lib mt76x2e mt7603e mt76_connac_lib mt76"
+MODULES_INSERT="mt76 mt76_connac_lib mt7603e mt76x02_lib mt76x2_common mt76x2e mt7615_common mt7615e"
+
+log() {
+    # Bug 5: 简单的日志滚动逻辑，防止撑满 /var (tmpfs) 内存
+    if [ -f "$LOG_FILE" ] && [ "$(du -k "$LOG_FILE" | cut -f1)" -gt "$MAX_LOG_SIZE" ]; then
+        mv "$LOG_FILE" "${LOG_FILE}.old"
+    fi
+    echo "$(date '+%F %T') $1" | tee -a "$LOG_FILE"
+    logger -t WWAN_WATCHDOG "$1"
+}
+
+get_interface() {
+    # Bug 3: 尝试多种方式获取 WWAN 的真实逻辑层或物理层接口名
+    # 优先从 ubus 获取 L3 链路设备名，其次尝试 uci 配置名
+    local iface=$(ubus call network.interface.wwan status 2>/dev/null | jsonfilter -e '@.l3_device')
+    [ -z "$iface" ] && iface=$(uci -q get network.wwan.device)
+    [ -z "$iface" ] && iface=$(uci -q get network.wwan.ifname)
+    
+    echo "$iface"
+}
+
+check_interface() {
+    # 如果当前接口变量为空，或者系统找不到该网卡设备
+    if [ -z "$INTERFACE" ] || ! ip link show "$INTERFACE" >/dev/null 2>&1; then
+        log "WARN: Interface '$INTERFACE' not found. Attempting to re-scan..."
+        
+        # 重新尝试获取接口名（解决开机瞬间 ubus 尚未就绪的问题）
+        INTERFACE=$(get_interface)
+        
+        if [ -z "$INTERFACE" ] || ! ip link show "$INTERFACE" >/dev/null 2>&1; then
+            log "ERROR: Still cannot find valid WWAN interface. Waiting for system ready..."
+            return 1
+        fi
+        log "SUCCESS: Found interface $INTERFACE"
+    fi
+    return 0
+}
+
+log "WATCHDOG START"
+[ -f "$FAIL_FILE" ] || echo 0 > "$FAIL_FILE"
+
+while true
+do
+    # Bug 2: 接口不存在时不退出，而是循环重试获取，防止 procd 频繁重启脚本
+    if ! check_interface; then
+        sleep 10  # 接口未就绪时缩短重试周期
+        continue
+    fi
+
+    # Bug 1: 使用 -I 绑定接口进行 ping 测试，确保探测的是 WWAN 链路而非有线网默认路由
+    PING_RESULT=$(ping -c "$PING_COUNT" -W 5 -I "$INTERFACE" "$TARGET" 2>/dev/null)
+    LOSS=$(echo "$PING_RESULT" | grep -o '[0-9]*% packet loss' | cut -d'%' -f1)
+    [ -z "$LOSS" ] && LOSS=100
+
+    log "INTERFACE=$INTERFACE LOSS=$LOSS%"
+
+    if [ "$LOSS" -ge "$LOSS_LIMIT" ]; then
+        FAIL=$(cat "$FAIL_FILE" 2>/dev/null || echo 0)
+        FAIL=$((FAIL + 1))
+        echo "$FAIL" > "$FAIL_FILE"
+        log "FAIL COUNT: $FAIL/$FAIL_LIMIT"
+
+        if [ "$FAIL" -ge "$FAIL_LIMIT" ]; then
+            log "CRITICAL: Connection lost. ACTION: RELOAD WIFI DRIVER"
+            wifi down
+            sleep 2
+            for m in $MODULES_REMOVE; do rmmod $m 2>/dev/null; done
+            sleep 3
+            for m in $MODULES_INSERT; do modprobe $m 2>/dev/null; done
+            sleep 5
+            wifi up
+            echo 0 > "$FAIL_FILE"
+            log "RELOAD SEQUENCE DONE"
+        fi
+    else
+        echo 0 > "$FAIL_FILE"
+    fi
+
+    sleep "$CHECK_INTERVAL"
+done
diff --git a/files/etc/init.d/wwan_watchdog b/files/etc/init.d/wwan_watchdog
new file mode 100755
index 0000000..3333333
--- /dev/null
+++ b/files/etc/init.d/wwan_watchdog
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+USE_PROCD=1
+
+start_service() {
+    procd_open_instance
+    procd_set_param command /bin/sh /usr/bin/wwan_watchdog.sh
+    # 设置 respawn 阈值防止极端情况下的进程抖动
+    procd_set_param respawn 3600 5 0
+    procd_set_param stdout 1
+    procd_set_param stderr 1
+    procd_close_instance
+}
+
