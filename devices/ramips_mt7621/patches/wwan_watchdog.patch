+#!/bin/sh
+
+chmod +x /usr/bin/wwan_watchdog.sh
+chmod +x /etc/init.d/wwan_watchdog
+
+/etc/init.d/wwan_watchdog enable
+/etc/init.d/wwan_watchdog start
+exit 0